{
  "name": "OOP Learning Sandbox",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",

  // ホストと同一パスでマウントする。~/.claude/projects（履歴・メモリ）がホストと共有される
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",

  "remoteUser": "vscode",

  "containerEnv": {
    // ホストの ~/.claude.json 由来の「ネイティブインストール済み」前提の警告を抑止する
    "DISABLE_INSTALLATION_CHECKS": "1",
    // bind mount 上の .venv とキャッシュが別FSでも、ハードリンク警告を出さずにコピーする
    "UV_LINK_MODE": "copy"
  },

  // マウント元が無いと起動に失敗する／ディレクトリ化するので、先に用意する
  "initializeCommand": "mkdir -p ${HOME}/.claude && touch ${HOME}/.claude.json",

  "mounts": [
    // skills / settings / 認証情報 / 履歴をホストと共有
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind",
    // plugins だけはコンテナ専用にする（ホストの絶対パス参照が壊れるのを防ぐ）
    "source=claude-plugins-${devcontainerId},target=/home/vscode/.claude/plugins,type=volume",
    "source=${localEnv:HOME}/.claude.json,target=/home/vscode/.claude.json,type=bind"
  ],

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "ms-python.python",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint"
      ]
    }
  },

  // uv を入れて dev 依存（pytest）を同期し、TS 実行環境と dev 依存（vitest）を入れる
  "postCreateCommand": "pip install uv && uv sync && npm install -g ts-node typescript && npm install"
}
